APP_NAME=Car Passport
APP_ENV=local

DATABASE_URL=postgresql+psycopg://car_passport:secret@postgres:5432/car_passport
TEST_DATABASE_URL=postgresql+psycopg://car_passport:secret@postgres:5432/car_passport_test

# Generate a real one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

S3_ENDPOINT_URL=http://minio:9000
# Only needed locally: the API reaches MinIO via the Docker network above,
# but a presigned download URL has to work from a browser on your host.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=car-passport
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

MAX_UPLOAD_SIZE_MB=10
